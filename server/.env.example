# ================================================================
# Somphea Reak Studio - Environment Variables Template
# Copy this file to '.env' and customize values for your deployment
# NEVER commit the actual '.env' file containing real secrets to git!
# ================================================================

# --- Server Configuration ---
PORT=5000
FLASK_ENV=production
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars-min

# --- Admin Authentication & Security ---
# Secret PIN required to log into the Admin Desk and perform privileged operations
ADMIN_PIN=YourStrongAdminSecretPIN2026!
ADMIN_RATE_LIMIT_MAX_ATTEMPTS=5
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Database Storage ---
# Path to SQLite database file
DATABASE_PATH=sompheareak.db

# --- Security Headers & CORS ---
ALLOWED_ORIGINS=https://sompheareak.com,https://www.sompheareak.com,https://admin.sompheareak.com,http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:5500
PRODUCTION_DOMAIN=https://sompheareak.com
TOKEN_LIFETIME_SECONDS=86400
ENABLE_SECURITY_HEADERS=True
MAX_CONTENT_LENGTH=16777216

# --- Studio Defaults ---
SELLER_TELEGRAM=sompheareak
SITE_TITLE=សម្ភារៈ - Somphea Reak
SITE_SUBTITLE=Premium Studio
TAGLINE=Cambodia Kingdom of Wonder
DELIVERY_FEE=1.5
VOUCHER_COST=25
VOUCHER_PCT=10
CUSTOM_BASE_PRICE=8.0
CHARM_PRICE=1.5
CUSTOM_PT=5

# --- Telegram MTProto Client (Username Verification) ---
TELEGRAM_API_ID=your_api_id_from_my_telegram_org
TELEGRAM_API_HASH=your_api_hash_from_my_telegram_org
TELEGRAM_SESSION_STRING=your_persistent_string_session
