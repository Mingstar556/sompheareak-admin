{
  "name": "sompheareak-admin-panel",
  "version": "1.0.0",
  "description": "Somphea Reak Studio – Admin Management Desk (Web & Mobile)",
  "author": "Somphea Reak Studio (សម្ភារៈ) <contact@sompheareak.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://admin.sompheareak.com",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --port 8082",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web --port 8082",
    "build": "EXPO_NO_TELEMETRY=1 expo export -p web",
    "build:web": "EXPO_NO_TELEMETRY=1 expo export -p web",
    "preview": "npx serve dist -l 8082",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "^4.0.0",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "expo": "^57.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-web": "~0.19.10"
  }
}
